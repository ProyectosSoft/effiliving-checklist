# Supabase — Project Settings > API
# Ambas son públicas por diseño (la seguridad la da Row Level Security) y quedan
# incluidas en el sitio estático al hacer `npm run deploy`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service role key NO va aquí: solo la usa la Edge Function supabase/functions/invite-user,
# donde Supabase la provee automáticamente.
